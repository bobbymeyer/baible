<% content_for :title, "Update your password" %>
<div class="auth">
  <h1>Update your password</h1>
  <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Again" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="actions"><%= form.submit "Save", class: "button" %></div>
  <% end %>
</div>
