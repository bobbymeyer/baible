<% content_for :title, "Overnight" %>
<div class="page-header">
  <h1>Overnight</h1>
</div>
<p class="prose">
  The night window is <strong><%= @window.label %></strong> (<%= link_to "Settings", settings_path(anchor: "night") %>).
  <% if @window.open? %>It's open now.<% else %>It opens in <%= distance_of_time_in_words(Time.current, @window.opens_at) %>.<% end %>
  What's queued goes into ComfyUI one thing at a time while it has nothing else: generations first, oldest first, then training.
  Nothing new starts after the window closes.
</p>

<% if (summary = @summaries.first) %>
  <section class="window" id="summary">
    <h2><%= summary.heading %></h2>
    <div class="prose summary-text"><%= simple_format(summary.text) %></div>
    <p class="hint">
      <% if summary.sent_at %>Sent to the morning webhook <%= time_ago_in_words(summary.sent_at) %> ago.
      <% elsif summary.error %><span class="alert-text">Not sent: <%= summary.error %></span>
      <% elsif !Webhook.enabled? %>Kept here only: set <code>MORNING_WEBHOOK_URL</code> to have it sent (README "Overnight").
      <% end %>
    </p>
    <% if @summaries.size > 1 %>
      <details>
        <summary>Earlier mornings</summary>
        <% @summaries.drop(1).each do |earlier| %>
          <h3><%= earlier.heading %></h3>
          <div class="prose summary-text"><%= simple_format(earlier.text) %></div>
        <% end %>
      </details>
    <% end %>
  </section>
<% end %>

<section class="window" id="tonight">
  <h2>Queued for tonight</h2>
  <% if @queued_batches.empty? && @queued_trainings.empty? %>
    <p class="empty">Nothing yet. "Queue for tonight" in a subject's studio, or "Train tonight" on an entry's training set.</p>
  <% else %>
    <table class="table">
      <thead><tr><th scope="col">What</th><th scope="col">Project</th><th scope="col">Size</th><th scope="col"></th></tr></thead>
      <tbody>
        <% @queued_batches.each do |batch| %>
          <tr id="<%= dom_id(batch) %>">
            <td><%= link_to batch.title, subject_path(batch.subject, anchor: "batches") %><br><small class="muted"><%= batch.subject.kind.name %></small></td>
            <td><%= batch.subject.project.name %></td>
            <td><%= pluralize(batch.candidates.size, "candidate") %></td>
            <td><%= button_to "Not tonight", subject_batch_path(batch.subject, batch), method: :delete, class: "link-button" %></td>
          </tr>
        <% end %>
        <% @queued_trainings.each do |run| %>
          <tr id="<%= dom_id(run) %>">
            <td><%= link_to "Train #{run.title}", entry_path(run.entry, anchor: "lora") %><br><small class="muted">a LoRA, on <%= run.model %></small></td>
            <td><%= run.entry.project.name %></td>
            <td><%= pluralize(run.items.size, "picture") %>, <%= run.settings["steps"] %> steps</td>
            <td><%= button_to "Not tonight", training_run_path(run), method: :delete, class: "link-button" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="window" id="made">
  <h2>Made overnight</h2>
  <% if @made.empty? && @trained.empty? %>
    <p class="empty">Nothing waiting for review.</p>
  <% end %>
  <% @trained.each do |run| %>
    <p id="<%= dom_id(run, :made) %>">
      <strong><%= link_to run.title, entry_path(run.entry, anchor: "lora") %></strong>
      <% if run.status == "done" %>
        trained<%= " in #{run_time(run.run_seconds)}" if run.run_seconds %>: <code><%= run.lora %></code>
      <% else %>
        <span class="alert-text">failed: <%= run.error %></span>
      <% end %>
    </p>
  <% end %>
  <% @made.group_by { |batch| batch.subject.project }.each do |project, batches| %>
    <h3><%= project.name %></h3>
    <% batches.each do |batch| %>
      <p class="hint"><%= link_to "#{batch.subject.kind.name}: #{batch.subject.name}'s studio", subject_path(batch.subject) %></p>
      <%= render "subjects/strip", batch: batch %>
    <% end %>
  <% end %>
  <% if @made.any? %>
    <p class="hint">Each strip stays until one of it is picked (Use this) or it's discarded.</p>
  <% end %>
</section>

<section class="window" id="orders">
  <h2>Every night</h2>
  <p class="hint">
    Standing orders: at the first tick of each night window, each queues what it's owed, after whatever was queued by hand. A target
    still waiting for review of an earlier night's batch gets nothing new until it's picked from or discarded, so unreviewed work
    doesn't pile up.
  </p>
  <% if @orders.any? %>
    <table class="table">
      <thead><tr><th scope="col">Order</th><th scope="col">For</th><th scope="col">Last night</th><th scope="col"></th></tr></thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr id="<%= dom_id(order) %>" class="<%= 'is-off' unless order.enabled? %>">
            <td>
              <strong><%= order.label %></strong><%= tag.span(" (off)", class: "muted") unless order.enabled? %><br>
              <small class="muted">
                <% if order.action == "train" %>
                  at <%= pluralize(order.min_pictures, "canon picture") %>, on <%= order.model || Comfy.config.dig(:training, :model).presence || "no model yet" %>
                <% else %>
                  <%= pluralize(order.count, "candidate") %> a target, at most <%= pluralize(order.nightly_limit, "batch") %> a night
                <% end %>
              </small>
            </td>
            <td><%= order.scope_label %><% if order.entry || order.kind %><br><small class="muted"><%= order.project.name %></small><% end %></td>
            <td><%= order.report || tag.span("Not planned yet", class: "muted") %><% if order.planned_at %><br><small class="muted"><%= time_ago_in_words(order.planned_at) %> ago</small><% end %></td>
            <td class="trainings__actions">
              <%= button_to order.enabled? ? "Turn off" : "Turn on", standing_order_path(order), method: :patch,
                            params: { standing_order: { enabled: order.enabled? ? "0" : "1" } }, class: "link-button", form: { class: "inline" } %>
              <%= button_to "Delete", standing_order_path(order), method: :delete, class: "link-button",
                            form: { class: "inline", data: { turbo_confirm: "Delete this standing order?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <% projects = Project.order(:name).includes(:kinds, :entries) %>
  <% if projects.empty? %>
    <p class="empty">Make a project first.</p>
  <% else %>
    <%= form_with model: @order, url: standing_orders_path, class: "form" do |f| %>
      <div class="field-row">
        <div class="field"><%= f.label :action, "Every night" %><%= f.select :action, StandingOrder::ACTIONS.invert %></div>
        <div class="field"><%= f.label :project_id, "In" %><%= f.select :project_id, projects.map { |p| [ p.name, p.id ] } %></div>
        <div class="field">
          <%= f.label :kind_id, "Only the kind" %>
          <%= f.select :kind_id, grouped_options_for_select(projects.map { |p| [ p.name, p.kinds.map { |k| [ k.name, k.id ] } ] }), include_blank: "Every kind" %>
        </div>
        <div class="field">
          <%= f.label :entry_id, "Only the entry" %>
          <%= f.select :entry_id, grouped_options_for_select(projects.map { |p| [ p.name, p.entries.map { |e| [ e.name, e.id ] } ] }), include_blank: "Every subject" %>
        </div>
      </div>
      <div class="field-row">
        <div class="field"><%= f.label :count, "Candidates a target" %><%= f.number_field :count, min: 1, max: 8 %></div>
        <div class="field"><%= f.label :nightly_limit, "At most, batches a night" %><%= f.number_field :nightly_limit, min: 1, max: 200 %></div>
        <div class="field"><%= f.label :min_pictures, "Train at, canon pictures" %><%= f.number_field :min_pictures, min: 1, max: 200 %></div>
        <div class="field field--wide"><%= f.label :model, "Train on" %><%= f.text_field :model, placeholder: Comfy.config.dig(:training, :model).presence || "an SDXL checkpoint" %></div>
      </div>
      <p class="hint">
        <strong>Fill the gaps</strong>: a batch for every target (a subject, or one of its variants) with nothing picked.
        <strong>Keep going until canon</strong>: a batch for every target with picks but none approved.
        <strong>Train when ready</strong> (needs an entry): once the entry has that many canon pictures, and they're not just what its last run
        trained on, a training run on them, after the night's generations; captions are written from their recipes. The kind and entry must
        be the project's; the last two fields are for training only.
      </p>
      <div class="actions"><%= f.submit "Add the standing order", class: "button" %></div>
    <% end %>
  <% end %>
</section>
