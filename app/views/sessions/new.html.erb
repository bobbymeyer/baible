<% content_for :title, "Sign in" %>
<div class="auth">
  <h1>Sign in</h1>
  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="actions"><%= form.submit "Sign in", class: "button button--primary" %></div>
  <% end %>
  <p class="hint">
    No account yet? Accounts are made on the server: <code>bin/rails users:create</code> (see the README).
    <%= link_to "Forgot your password?", new_password_path %>
  </p>
</div>
