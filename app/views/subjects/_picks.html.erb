<%# The subject's pick and each variant's: what leaves baible, as a file and a sidecar (docs/HANDOFF.md "Export"). %>
<% targets = [ nil, *subject.variants ] %>
<ul class="picks">
  <% targets.each do |variant| %>
    <% pick = subject.pick_for(variant) %>
    <li class="pick <%= 'is-empty' unless pick %>" id="<%= variant ? dom_id(variant, :pick) : 'pick_subject' %>">
      <figure>
        <% if pick&.image? %>
          <%= link_to url_for(pick.file), target: "_blank", rel: "noopener" do %><%= image_tag url_for(pick.file), alt: pick.title, class: "thumb" %><% end %>
        <% elsif pick&.audio? %>
          <span class="plate plate--audio" aria-hidden="true"></span>
          <audio controls preload="none" src="<%= url_for(pick.file) %>"></audio>
        <% else %>
          <span class="plate <%= 'plate--audio' if subject.audio? %>" aria-hidden="true"><%= "?" unless subject.audio? %></span>
        <% end %>
        <figcaption>
          <strong><%= variant ? variant.name : subject.name %></strong>
          <% if pick %>
            Seed <%= pick.seed %><%= tag.span(" · #{run_time(pick.run_seconds)}", class: "muted") if pick.run_seconds %>
          <% else %>
            <span class="muted">Nothing picked yet</span>
          <% end %>
        </figcaption>
      </figure>
      <% if pick %>
        <div class="pick__links">
          <%= link_to "Download", pick_download_path(pick), data: { turbo: false } %>
          <%= link_to "Sidecar", pick_sidecar_path(pick), data: { turbo: false }, title: "How it was made, as JSON" %>
          <%= button_to "Let go", pick_path(pick), method: :delete, class: "link-button", form: { class: "inline", data: { turbo_confirm: "Let #{pick.title}'s pick go?" } } %>
        </div>
        <details>
          <summary>How it was made</summary>
          <%= render "subjects/recipe", recipe: pick.recipe %>
        </details>
      <% end %>
    </li>
  <% end %>
</ul>
