<%# An entry's fields. entry; url. %>
<%= form_with model: entry, url: url, class: "form" do |f| %>
  <%= render "shared/errors", record: entry %>
  <div class="field field--wide"><%= f.label :name %><%= f.text_field :name, required: true, autofocus: entry.new_record?, placeholder: "Cid, the harbour town, the Tidewardens" %></div>
  <div class="field">
    <%= f.label :look, "Look" %>
    <%= f.text_area :look, rows: 3, placeholder: "tall, weathered man, grey stubble, eyepatch over his left eye, red wool coat, brass buttons" %>
    <p class="hint">What stays true in every picture of it: face, build, marks, the clothes it's known by. It comes after the kind's framing, word for word, in every image recipe of its subjects; the language model never rewrites it. What it looks like in one picture (wet, wounded, in winter) belongs in that subject or a variant.</p>
  </div>
  <div class="field">
    <%= label_tag "entry_loras_0_name", "LoRAs" %>
    <%= render "shared/loras", name: "entry[loras]", loras: entry.loras, above: ArtDirection.stack_loras(entry.project.loras) %>
    <p class="hint">A LoRA trained on it, say. They stack after the kind's, before the subject's.</p>
  </div>
  <div class="field">
    <%= f.label :trigger, "Trigger" %>
    <%= f.text_field :trigger, placeholder: entry.name.to_s.parameterize(separator: "_").presence || "cid" %>
    <p class="hint">The word a LoRA trained on it answers to (section "LoRA" on its page). Blank uses its name.</p>
  </div>
  <div class="field">
    <%= f.label :lore, "Lore" %>
    <%= f.text_area :lore, rows: 10, placeholder: "Who or what it is, where it stands in the story, what's canon. Never in a prompt." %>
  </div>
  <div class="actions">
    <%= f.submit entry.new_record? ? "Add the entry" : "Save", class: "button button--primary" %>
    <%= link_to "Cancel", entry.new_record? ? project_entries_path(entry.project) : entry_path(entry), class: "button button--quiet" %>
  </div>
<% end %>
