<%# A kind: the middle layer of its subjects' recipes, maybe derived from another, or a sheet. The medium decides which
    fields show (kind-switch). %>
<%= form_with model: [ project, kind ], class: "form", data: { controller: "kind-switch" } do |f| %>
  <%= render "shared/errors", record: kind %>
  <%= render "shared/installed" %>
  <div class="field-row">
    <div class="field field--wide"><%= f.label :name %><%= f.text_field :name, required: true, placeholder: "Monster sprite, Location, Portrait, Theme music…" %></div>
    <div class="field">
      <%= f.label :medium %>
      <%= f.select :medium, Kind::MEDIA.map { |m| [ m.humanize, m ] }, {}, data: { kind_switch_target: "select", action: "kind-switch#update" },
                   disabled: kind.persisted? && kind.subjects.any? %>
      <% if kind.persisted? && kind.subjects.any? %><p class="hint">Fixed once it has subjects.</p><% end %>
    </div>
  </div>
  <% parents = project.kinds.select { |other| other.image? && other != kind && (kind.new_record? || other.ancestors.exclude?(kind)) } %>
  <%= tag.fieldset class: "bare", data: { show_for: "image sheet" }, hidden: kind.audio?, disabled: kind.audio? do %>
    <div class="field">
      <%= f.label :parent_id, kind.sheet? ? "A sheet of" : "Derives from" %>
      <%= f.select :parent_id, parents.map { |other| [ other.name, other.id ] }, include_blank: "Nothing: a kind of its own" %>
      <p class="hint">
        Derived, each subject of this kind is of one of that kind's subjects (Cid's portrait, of Cid the character), taking its words,
        LoRAs and entry. A sheet lays out the picks of one subject of it and what derives from that.
      </p>
    </div>
  <% end %>
  <%= tag.fieldset class: "bare", data: { show_for: "image audio" }, hidden: kind.sheet?, disabled: kind.sheet? do %>
    <div class="field">
      <%= f.label :prompt, "Framing" %>
      <%= f.text_area :prompt, rows: 2 %>
      <%= tag.p class: "hint", data: { show_for: "image" }, hidden: !kind.image? do %>How this kind is framed, after the house style: “a single monster, full body, profile view, plain white background”.<% end %>
      <%= tag.p class: "hint", data: { show_for: "audio" }, hidden: !kind.audio? do %>Tags after the project's sound: “battle theme, fast, drums, loopable”.<% end %>
    </div>
  <% end %>
  <%= tag.fieldset class: "bare", data: { show_for: "sheet" }, hidden: !kind.sheet?, disabled: !kind.sheet? do %>
    <div class="field">
      <span class="label">What it lays out</span>
      <%= hidden_field_tag "kind[sheet_kind_ids][]", "", id: nil %>
      <div class="checks">
        <% (kind.parent ? kind.parent.lineage : project.kinds).select { |other| other.image? && other != kind }.each do |other| %>
          <span class="field--check">
            <%= check_box_tag "kind[sheet_kind_ids][]", other.id, kind.sheet_kind_ids.include?(other.id), id: "kind_sheet_kind_#{other.id}" %>
            <%= label_tag "kind_sheet_kind_#{other.id}", other.name %>
          </span>
        <% end %>
      </div>
      <p class="hint">Of the kind it's a sheet of and those derived from it; none ticked lays out all of them. Each target's canon pick, else its current one, a row for each subject.</p>
    </div>
  <% end %>
  <%= tag.fieldset class: "bare", data: { show_for: "image" }, hidden: !kind.image?, disabled: !kind.image? do %>
    <div class="field">
      <%= f.label :negative %>
      <%= f.text_area :negative, rows: 1 %>
    </div>
    <p class="hint">Sizes are scaled into the model's trained range, keeping their shape.</p>
    <div class="field-row">
      <div class="field"><%= f.label :width %><%= f.number_field :width, min: Kind::SIZES.min, max: Kind::SIZES.max, step: 64 %></div>
      <div class="field"><%= f.label :height %><%= f.number_field :height, min: Kind::SIZES.min, max: Kind::SIZES.max, step: 64 %></div>
      <div class="field field--check">
        <%= f.check_box :transparent %>
        <%= f.label :transparent, "Remove the background" %>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <%= f.label :derive, "Its subjects start from" %>
        <%= f.select :derive, Kind::DERIVE.invert %>
      </div>
      <div class="field">
        <%= f.label :derive_denoise, "Re-noise" %>
        <%= f.number_field :derive_denoise, min: 0.1, max: 1, step: 0.05, placeholder: Comfy.config.fetch(:chain, {})[:denoise].to_s %>
      </div>
    </div>
    <p class="hint">
      For a derived kind: its parent subject's words alone, or redrawing its picture (or the head cut from it, for a portrait from a full figure), once
      it has one; the studio can choose otherwise. A variant redraws its own subject's picture. Blank re-noise is
      <%= Comfy.config.fetch(:chain, {})[:head_denoise] %> for a head, <%= Comfy.config.fetch(:chain, {})[:denoise] %> otherwise.
    </p>
    <%= render "shared/model_field", name: "kind[model]", id: "kind_model", value: kind.model, inherited: project.model.presence || Comfy.config[:model] %>
    <% workflows = LearnedWorkflow.accepted.order(:name) %>
    <% if workflows.any? || kind.learned_workflow %>
      <div class="field">
        <%= f.label :learned_workflow_id, "Workflow" %>
        <%= f.select :learned_workflow_id, (workflows.to_a | [ kind.learned_workflow ].compact).map { |w| [ "#{w.name}#{' (not accepted)' unless w.accepted?}", w.id ] },
                     include_blank: "Built by baible for the model" %>
        <p class="hint">A learned workflow (<%= link_to "Models and workflows", learning_path %>) makes this kind's pictures instead: no drafts or background removal of baible's, and a pick to start from only if the workflow takes one.</p>
      </div>
    <% end %>
    <%= render "shared/loras", name: "kind[loras]", loras: kind.loras, above: ArtDirection.stack_loras(project.loras) %>
  <% end %>
  <%= tag.fieldset class: "bare", data: { show_for: "audio" }, hidden: !kind.audio?, disabled: !kind.audio? do %>
    <div class="field-row">
      <div class="field"><%= f.label :seconds, "Seconds" %><%= f.number_field :seconds, min: Kind::SECONDS.min, max: Kind::SECONDS.max %></div>
    </div>
    <%= render "shared/model_field", name: "kind[model]", id: "kind_audio_model", value: kind.model, inherited: Comfy::Music.default_model, audio: true %>
  <% end %>
  <%= tag.fieldset class: "bare", data: { show_for: "image audio" }, hidden: kind.sheet?, disabled: kind.sheet? do %>
    <div class="field">
      <%= f.label :variant_presets, "Variants each new subject starts with" %>
      <%= f.text_area :variant_presets, value: kind.variant_presets_text, rows: 4, placeholder: "happy: smiling happily\nsad: sad expression, downcast eyes" %>
      <p class="hint">One a line: a name, a colon, and the words it adds after the subject.</p>
    </div>
  <% end %>
  <div class="actions">
    <%= f.submit kind.new_record? ? "Add the kind" : "Save", class: "button button--primary" %>
    <%= link_to "Cancel", project_kinds_path(project), class: "button button--quiet" %>
  </div>
<% end %>
