<% content_for :title, "#{@kind.name} · #{@project.name}" %>
<div class="crumbs"><%= link_to @project.name, project_path(@project) %> / <%= link_to "Kinds", project_kinds_path(@project) %></div>
<h1><%= @kind.name %></h1>
<%= render "form", project: @project, kind: @kind %>
<section class="window">
  <h2>Delete the kind</h2>
  <% if @kind.subjects.any? %>
    <p class="hint"><%= pluralize(@kind.subjects.size, "subject") %> still <%= @kind.subjects.size == 1 ? "is" : "are" %> this kind: move or delete them first.</p>
  <% else %>
    <%= button_to "Delete #{@kind.name}", project_kind_path(@project, @kind), method: :delete, class: "button button--danger",
                  form: { data: { turbo_confirm: "Delete #{@kind.name}?" } } %>
  <% end %>
</section>
