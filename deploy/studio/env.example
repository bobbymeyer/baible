# ~/stacks/baible/.env — mode 600, never in git. Make it without the key
# touching scrollback:
#   ( umask 077; printf 'SECRET_KEY_BASE=%s\n' "$(openssl rand -hex 64)" > ~/stacks/baible/.env )
#
# Must stay stable: changing it signs everyone out. There is no
# RAILS_MASTER_KEY: nothing in baible reads the encrypted credentials.
SECRET_KEY_BASE=

# Optional: a rented GPU to train LoRAs on (README "A rented GPU"). Its
# ComfyUI, and RunPod starting the pod before each run and stopping it
# after. Leave them commented out and training stays on the Studio.
# TRAINING_COMFY_URL=https://<pod id>-8188.proxy.runpod.net
# RUNPOD_POD_ID=<pod id>
# RUNPOD_API_KEY=
